- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nclass\
      \ blk(gr.sync_block):\n    \"\"\"Reassemble decoded bytes using frame_info;\
      \ forward only CRC-valid packets.\"\"\"\n    def __init__(self):\n        gr.sync_block.__init__(self,\
      \ name='CRC-valid payload to PDU', in_sig=[np.uint8], out_sig=None)\n      \
      \  self.message_port_register_out(pmt.intern('pdus'))\n        self.remaining\
      \ = 0\n        self.payload = bytearray()\n        self.valid = False\n    \
      \    self.metadata = pmt.PMT_NIL\n\n    def work(self, input_items, output_items):\n\
      \        data = input_items[0]\n        start = self.nitems_read(0)\n      \
      \  tags = {int(t.offset-start): t.value for t in self.get_tags_in_window(0,\
      \ 0, len(data), pmt.intern('frame_info'))}\n        for i, value in enumerate(data):\n\
      \            if i in tags:\n                self.metadata = tags[i]\n      \
      \          self.remaining = pmt.to_long(pmt.dict_ref(self.metadata, pmt.intern('pay_len'),\
      \ pmt.from_long(0)))\n                self.valid = pmt.to_bool(pmt.dict_ref(self.metadata,\
      \ pmt.intern('crc_valid'), pmt.PMT_F))\n                self.payload = bytearray()\n\
      \            if self.remaining > 0:\n                self.payload.append(int(value))\n\
      \                self.remaining -= 1\n                if self.remaining == 0\
      \ and self.valid:\n                    self.message_port_pub(pmt.intern('pdus'),\
      \ pmt.cons(self.metadata, pmt.init_u8vector(len(self.payload), list(self.payload))))\n\
      \        return len(data)\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 680
    rotation: 0
    state: enabled
