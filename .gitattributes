# In GNU Radio 3.9+, pybind11 compares hash values of headers and source
# files against knowns values.  Conversion of values to CRLF on checkout
# break those checks so keep LF values when files are subject to said checks
#
*.h    text eol=lf
*.c    text eol=lf
*.cc   text eol=lf

# Keep GNU Radio/Linux source files using LF
* text=auto

*.h   text eol=lf
*.c   text eol=lf
*.cc  text eol=lf
*.cpp text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.grc text eol=lf

# Windows project files
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.bmp binary
*.tiff binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.lib binary
*.so binary
*.dylib binary
*.o binary
*.obj binary
*.a binary
*.lib binary
*.so binary
*.dylib binary